NEXT_PUBLIC_SUPABASE_URL=
# Preferred client key. Keep the legacy anon key only as a compatibility fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Use a Supabase secret key (or the legacy service-role key), never a publishable key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TLM-1 server-only telemetry controls. Never expose these with NEXT_PUBLIC_.
FORNEXA_TELEMETRY_OWNER_EMAILS=
FORNEXA_TELEMETRY_HASH_SECRET=

# Multi-model review orchestrator — server-side only. Never prefix with NEXT_PUBLIC_.
# Provider model names are configuration, not hardcoded application behavior.
OPENAI_API_KEY=
FORNEXA_OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
FORNEXA_ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEEPSEEK_API_KEY=
FORNEXA_DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Hard-bounded by code: timeout 2-45s, output 256-4000 tokens, retries 0-1.
FORNEXA_AI_TIMEOUT_MS=20000
FORNEXA_AI_MAX_OUTPUT_TOKENS=2000
FORNEXA_AI_MAX_RETRIES=1
# Temporary Preview-only activation. Must remain false outside the controlled MMO-1 run.
FORNEXA_AI_REVIEW_ENABLED=false

# Canonical public origin used in activation and password-recovery links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

RESEND_API_KEY=
EMAIL_FROM=FORNEXA <fornexa@fornexasc.com>
OFFERS_FROM_EMAIL=FORNEXA Ofertas <ofertas@fornexa.eu>
OFFERS_REPLY_TO=fragonh2@gmail.com

# Telematics providers — server-side only. Never prefix secrets with NEXT_PUBLIC_.
SAMSARA_API_TOKEN=

CARTRACK_BASE_URL=
CARTRACK_USERNAME=
CARTRACK_PASSWORD=

FLEETGO_BASE_URL=https://api.fleetgo.com
FLEETGO_ACCESS_TOKEN=

VDO_FLEET_BASE_URL=
VDO_FLEET_TOKEN=

WEBFLEET_BASE_URL=
WEBFLEET_CLIENT_ID=
WEBFLEET_CLIENT_SECRET=
WEBFLEET_API_KEY=

VOLVO_BASE_URL=
VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=

SCANIA_BASE_URL=
SCANIA_CLIENT_ID=
SCANIA_CLIENT_SECRET=

MAN_RIO_BASE_URL=
MAN_RIO_CLIENT_ID=
MAN_RIO_CLIENT_SECRET=

GEOTAB_SERVER=my.geotab.com
GEOTAB_DATABASE=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=
